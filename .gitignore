# Build artifacts
node_modules/
.next/
dist/
build/
out/
coverage/
.gradle/
target/

# Custom Java/Kotlin output dirs (platform-build-logic java-conventions
# uses `bin/main` / `bin/test` instead of `build/classes/...`).
**/bin/

# Editor / IDE
.idea/
.vscode/
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lockfiles — committed (do not ignore)
# !pnpm-lock.yaml
# !gradle.lockfile
# !gradle/verification-metadata.xml

# Env / secrets (never commit)
.env
.env.*
!.env.example
secrets/

# Tooling caches
.turbo/
.eslintcache
.kotlin/

# Generated code (OpenAPI / Protobuf / Avro / JavaPoet outputs).
# The contracts in `contracts/` are the source of truth; the
# generated artefacts are reproducible by `pnpm codegen:*`.
**/src/lib/api/generated/
**/src/generated/

# Security CI artefacts. Reproducible via `pnpm security`.
security/artifacts/
*.sarif
cosign.pub
cosign.key