{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "config": {
    "default": true,
    "MD004": false,
    "MD013": false,
    "MD022": false,
    "MD024": { "siblings_only": true },
    "MD032": false,
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD046": { "style": "fenced" },
    "MD047": false
  },
  "globs": [
    "**/*.md",
    "#node_modules",
    "#**/node_modules",
    "#**/build",
    "#**/dist",
    "#**/.next",
    "#**/target",
    "#**/coverage",
    "#**/.gradle",
    "#.kiro/specs/genealogy-platform/evidence/**"
  ],
  "ignores": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/.next/**",
    "**/target/**",
    "**/coverage/**",
    "**/.gradle/**",
    ".kiro/specs/genealogy-platform/evidence/**"
  ]
}