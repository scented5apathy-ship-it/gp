link-workspace-packages=true
prefer-workspace-packages=true
shared-workspace-lockfile=true
save-workspace-protocol=true
auto-install-peers=true
strict-peer-dependencies=false
node-linker=isolated
package-import-method=hardlink
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*

# Supply-chain hardening (per tasks.md E1.6 / privacy-and-legal-gate.md
# TM-08). The remaining pnpm-specific keys (trustPolicy,
# blockExoticSubdeps, minimumReleaseAge) live in `pnpm-workspace.yaml`.
#
# `min-release-age` is the legacy / fallback pnpm 9 .npmrc spelling
# that doubles as a no-downgrade guard for callers that bypass the
# workspace config. Units are days (Semgrep p/npm-missing-minimum-
# release-age requires a value ≥ 7).
min-release-age=7