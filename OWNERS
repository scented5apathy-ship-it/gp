# CODEOWNERS mirror of config/teams.yaml.
# Format compatible with both GitHub CODEOWNERS and the Gerrit-style
# OWNERS files that Argo CD / Renovate can consume.
#
# Generated by tools/scripts/sync-team-map.ts from config/teams.yaml.
# Keep this file in sync; the sync script must run in CI.

# Default ownership for everything not otherwise covered.
/              @genealogy/platform

# Services — one row per domain service. Cross-service changes need
# sign-off from @genealogy/platform in addition to the service team.
/services/tenant-service/        @genealogy/identity
/services/genealogy-service/     @genealogy/genealogy
/services/research-service/      @genealogy/research
/services/collaboration-service/ @genealogy/collaboration
/services/media-service/         @genealogy/media
/services/search-service/        @genealogy/search
/services/importexport-service/  @genealogy/import-export
/services/dna-service/           @genealogy/dna
/services/notification-service/  @genealogy/notification
/services/reporting-service/     @genealogy/reporting
/services/audit-service/         @genealogy/identity @genealogy/security

# Edge / BFF / public API
/apps/web/                       @genealogy/web
/apps/web-bff/                   @genealogy/web
/apps/public-api/                @genealogy/web

# Background workers.
/workers/media-worker/           @genealogy/media
/workers/search-indexer/         @genealogy/search
/workers/export-worker/          @genealogy/import-export

# Contracts.
/contracts/openapi/              @genealogy/web @genealogy/platform
/contracts/protobuf/             @genealogy/platform
/contracts/events/               @genealogy/platform

# Platform & config-as-code.
/platform/                       @genealogy/platform
/config/teams.yaml               @genealogy/platform
/docs/ownership/                 @genealogy/platform

# CI / supply-chain tooling.
/.github/                        @genealogy/platform @genealogy/security
/scripts/                        @genealogy/platform
/tools/                          @genealogy/platform

# Privacy-sensitive areas.
/services/dna-service/           @genealogy/dna @genealogy/security @genealogy/privacy
/services/audit-service/         @genealogy/identity @genealogy/security