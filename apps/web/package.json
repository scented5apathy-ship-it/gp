{
  "name": "@genealogy/web",
  "version": "0.1.0",
  "private": true,
  "description": "Genealogy Platform — Next.js PWA shell (public surface + authenticated shell).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --turbopack=false",
    "start": "next start -p 3000",
    "lint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,mjs,cjs,mts,cts}\"",
    "lint:eslint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,mjs,cjs,mts,cts}\"",
    "lint:yaml": "node ../../scripts/lint-yaml.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/test-ts.mjs \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:unit": "node ../../scripts/test-ts.mjs \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:integration": "echo 'no integration tests for @genealogy/web yet (lands in E5/E6)'",
    "test:contract": "node ../../scripts/test-contracts.mjs",
    "test:e2e": "echo 'no e2e tests for @genealogy/web yet (lands in E6 with Playwright)'",
    "codegen:client": "node scripts/codegen-openapi-client.mjs",
    "format": "prettier --write --log-level=warn --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}\" \"public/**/*.{json,webmanifest}\" \"package.json\" \"next.config.mjs\" \"tsconfig.json\" \"tailwind.config.ts\" \"postcss.config.mjs\"",
    "format:check": "prettier --check --log-level=warn --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}\" \"public/**/*.{json,webmanifest}\" \"package.json\" \"next.config.mjs\" \"tsconfig.json\" \"tailwind.config.ts\" \"postcss.config.mjs\"",
    "clean": "rimraf node_modules .next dist .turbo coverage src/lib/api/generated"
  },
  "dependencies": {
    "@genealogy/api-client": "workspace:*",
    "@genealogy/i18n": "workspace:*",
    "@genealogy/ui": "workspace:*",
    "next": "15.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "9.13.0",
    "js-yaml": "4.1.0",
    "openapi-typescript": "7.4.2",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2"
  }
}
