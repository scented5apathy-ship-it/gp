{
  "type": "record",
  "name": "PersonDeleted",
  "namespace": "com.genealogy.platform.events.genealogy.v1",
  "doc": "Emitted when a person aggregate is soft-deleted (terminal lifecycle state = DELETED). The aggregate row stays on disk for audit / reversal (E4.6 merge history) but the search + public projections drop the person. Carries the opaque actor and reason only. Compatibility policy = BACKWARD per ADR-E0.5-08.",
  "fields": [
    {
      "name": "personId",
      "type": "com.genealogy.platform.events.shared.v1.OpaqueId"
    },
    {
      "name": "treeId",
      "type": "com.genealogy.platform.events.shared.v1.OpaqueId"
    },
    {
      "name": "aggregateVersion",
      "type": "long"
    },
    {
      "name": "actorId",
      "type": "com.genealogy.platform.events.shared.v1.OpaqueId"
    },
    {
      "name": "reason",
      "type": "string"
    },
    {
      "name": "deletedAt",
      "type": "string",
      "logicalType": "timestamp-millis"
    }
  ]
}
