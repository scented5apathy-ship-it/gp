{
  "type": "record",
  "name": "TreeArchived",
  "namespace": "com.genealogy.platform.events.genealogy.v1",
  "doc": "Emitted when a tree is archived (soft-deleted / hidden). Search projections and public projections MUST drop the tree until a TreeRestored event lands. Compatibility policy = BACKWARD per ADR-E0.5-08.",
  "fields": [
    {
      "name": "treeId",
      "type": "com.genealogy.platform.events.shared.v1.OpaqueId"
    },
    {
      "name": "actorId",
      "type": "com.genealogy.platform.events.shared.v1.OpaqueId"
    },
    {
      "name": "reason",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "archivedAt",
      "type": "string",
      "logicalType": "timestamp-millis"
    }
  ]
}
