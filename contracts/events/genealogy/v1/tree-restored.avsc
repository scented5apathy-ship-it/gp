{
  "type": "record",
  "name": "TreeRestored",
  "namespace": "com.genealogy.platform.events.genealogy.v1",
  "doc": "Emitted when a previously archived tree is restored. Search projections and public projections MUST rebuild the tree. Compatibility policy = BACKWARD per ADR-E0.5-08.",
  "fields": [
    {
      "name": "treeId",
      "type": "com.genealogy.platform.events.shared.v1.OpaqueId"
    },
    {
      "name": "actorId",
      "type": "com.genealogy.platform.events.shared.v1.OpaqueId"
    },
    {
      "name": "reason",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "restoredAt",
      "type": "string",
      "logicalType": "timestamp-millis"
    }
  ]
}
