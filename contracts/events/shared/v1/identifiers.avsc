{
  "type": "record",
  "name": "OpaqueId",
  "namespace": "com.genealogy.platform.events.shared.v1",
  "doc": "Opaque server-issued identifier carried inside event payloads. Format matches the REST/gRPC identifier shape.",
  "fields": [
    {
      "name": "value",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    }
  ]
}
