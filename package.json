{
  "name": "genealogy-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Genealogy Platform monorepo — SaaS + on-premise, privacy-first, contract-first.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "format": "pnpm -r --parallel format",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf node_modules",
    "check:workspaces": "pnpm exec scripts/check-monorepo-boundaries.mjs",
    "check:lockfile": "pnpm install --frozen-lockfile --no-frozen-lockfile=false",
    "release": "turbo run build --filter=...{git origin/main...HEAD}"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "rimraf": "6.0.1",
    "turbo": "2.1.3",
    "typescript": "5.6.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "allowedDeprecatedVersions": [],
    "onlyBuiltDependencies": []
  }
}