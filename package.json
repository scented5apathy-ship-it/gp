{
  "name": "genealogy-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Genealogy Platform monorepo — SaaS + on-premise, privacy-first, contract-first.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "format": "pnpm run -r --parallel format && pnpm format:root",
    "format:root": "prettier --write --log-level=warn --ignore-unknown --no-error-on-unmatched-pattern \".github/**/*.{md,yaml,yml,json}\" \"*.{md,json,yaml,yml}\" \"docs/**/*.md\" \"config/**/*.yaml\" \".kiro/**/*.md\"",
    "format:check": "pnpm run -r --parallel format:check && pnpm exec prettier --check --log-level=warn --ignore-unknown --no-error-on-unmatched-pattern \".github/**/*.{md,yaml,yml,json}\" \"*.{md,json,yaml,yml}\" \"docs/**/*.md\" \"config/**/*.yaml\" \".kiro/**/*.md\"",
    "lint": "pnpm run -r --parallel lint && pnpm lint:root",
    "lint:root": "pnpm lint:eslint && pnpm lint:yaml && pnpm lint:openapi && pnpm lint:markdown && pnpm lint:ownership",
    "lint:eslint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern \"{packages,tools,scripts}/**/*.{ts,tsx,js,mjs,cjs,mts,cts}\" \"*.{js,mjs,cjs,mts,cts}\"",
    "lint:yaml": "node scripts/lint-yaml.mjs",
    "lint:openapi": "node scripts/lint-openapi.mjs",
    "lint:events": "node scripts/lint-events.mjs",
    "lint:markdown": "markdownlint-cli2 --config .markdownlint-cli2.jsonc \"**/*.md\" \"#node_modules\" \"#**/node_modules\" \"#**/build\" \"#**/dist\" \"#**/.next\" \"#**/target\" \"#**/coverage\" \"#**/.gradle\"",
    "lint:helm": "node scripts/lint-helm.mjs",
    "lint:protobuf": "node scripts/lint-protobuf.mjs",
    "lint:kong": "node scripts/lint-kong-config.mjs",
    "smoke:kong": "node scripts/smoke-kong.mjs",
    "lint:kafka": "node scripts/lint-kafka-config.mjs",
    "smoke:apicurio": "node scripts/smoke-apicurio.mjs",
    "lint:temporal": "node scripts/lint-temporal-config.mjs",
    "smoke:temporal": "node scripts/smoke-temporal.mjs",
    "lint:istio": "node scripts/lint-istio-config.mjs",
    "smoke:istio": "node scripts/smoke-istio.mjs",
    "lint:vault": "node scripts/lint-vault-config.mjs",
    "smoke:vault": "node scripts/smoke-vault.mjs",
    "lint:s3": "node scripts/lint-s3-config.mjs",
    "smoke:s3": "node scripts/smoke-s3.mjs",
    "check:s3:compat": "node scripts/check-s3-compatibility.mjs",
    "lint:flagsmith": "node scripts/lint-flagsmith-config.mjs",
    "smoke:flagsmith": "node scripts/smoke-flagsmith.mjs",
    "lint:argo": "node scripts/lint-argo-config.mjs",
    "smoke:argo": "node scripts/smoke-argo.mjs",
    "lint:grafana": "node scripts/lint-grafana-config.mjs",
    "smoke:grafana": "node scripts/smoke-grafana.mjs",
    "lint:keycloak": "node scripts/lint-keycloak-config.mjs",
    "smoke:keycloak": "node scripts/smoke-keycloak.mjs",
    "lint:openfga": "node scripts/lint-openfga-config.mjs",
    "smoke:openfga": "node scripts/smoke-openfga.mjs",
    "lint:abac": "node scripts/lint-abac-config.mjs",
    "lint:audit": "node scripts/lint-audit-config.mjs",
    "lint:trustedContext": "node scripts/lint-trusted-context.mjs",
    "lint:tree": "node scripts/lint-tree-config.mjs",
    "lint:person": "node scripts/lint-person-config.mjs",
    "lint:dateplace": "node scripts/lint-dateplace-config.mjs",
    "lint:relationship": "node scripts/lint-relationship-config.mjs",
    "lint:eventClaim": "node scripts/lint-event-claim-config.mjs",
    "lint:personMerge": "node scripts/lint-person-merge-config.mjs",
    "lint:outboxRelay": "node scripts/lint-outbox-relay-config.mjs",
    "lint:treeRendererBench": "node scripts/lint-tree-renderer-bench.mjs",
    "lint:treeProjection": "node scripts/lint-tree-projection.mjs",
    "lint:profileEditor": "node scripts/lint-profile-editor.mjs",
    "lint:a11yI18n": "node scripts/lint-a11y-i18n.mjs",
    "smoke:a11y": "node scripts/smoke-a11y.mjs",
    "lint:printExport": "node scripts/lint-print-export.mjs",
    "smoke:printExport": "node scripts/smoke-print-export.mjs",
    "check:printExport": "pnpm lint:printExport && node --test scripts/__tests__/lint-print-export.test.mjs",
    "lint:research": "node scripts/lint-research-config.mjs",
    "check:research": "pnpm lint:research && node --test scripts/__tests__/lint-research-config.test.mjs",
    "lint:collaboration": "node scripts/lint-collaboration-config.mjs",
    "check:collaboration": "pnpm lint:collaboration && node --test scripts/__tests__/lint-collaboration-config.test.mjs",
    "lint:collaboration:mixed": "node scripts/lint-collaboration-mixed-policy.mjs",
    "check:collaboration:mixed": "pnpm lint:collaboration:mixed && node --test scripts/__tests__/lint-collaboration-mixed-policy.test.mjs",
    "check:audit": "pnpm lint:audit && node --test scripts/__tests__/lint-audit-config.test.mjs",
    "check:tree": "pnpm lint:tree && node --test scripts/__tests__/lint-tree-config.test.mjs",
    "check:person": "pnpm lint:person && node --test scripts/__tests__/lint-person-config.test.mjs",
    "check:dateplace": "pnpm lint:dateplace && node --test scripts/__tests__/lint-dateplace-config.test.mjs",
    "check:relationship": "pnpm lint:relationship && node --test scripts/__tests__/lint-relationship-config.test.mjs",
    "check:eventClaim": "pnpm lint:eventClaim && node --test scripts/__tests__/lint-event-claim-config.test.mjs",
    "check:personMerge": "pnpm lint:personMerge && node --test scripts/__tests__/lint-person-merge-config.test.mjs",
    "check:outboxRelay": "pnpm lint:outboxRelay && node --test scripts/__tests__/lint-outbox-relay-config.test.mjs",
    "check:treeRendererBench": "pnpm lint:treeRendererBench && node --test scripts/__tests__/lint-tree-renderer-bench.test.mjs",
    "check:treeProjection": "pnpm lint:treeProjection && node --test scripts/__tests__/lint-tree-projection.test.mjs",
    "check:profileEditor": "pnpm lint:profileEditor && node --test scripts/__tests__/lint-profile-editor.test.mjs",
    "check:a11yI18n": "pnpm lint:a11yI18n && node --test scripts/__tests__/lint-a11y-i18n.test.mjs",
    "check:trustedContext": "pnpm lint:trustedContext && node --test scripts/__tests__/lint-trusted-context.test.mjs",
    "lint:ownership": "node scripts/check-ownership-coverage.mjs",
    "lint:generated": "node scripts/check-generated-code.mjs",
    "typecheck": "pnpm run -r --parallel typecheck",
    "test": "pnpm run -r --parallel test",
    "test:unit": "pnpm run -r --parallel test:unit && pnpm test:scripts",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:integration": "pnpm run -r --parallel test:integration",
    "test:contract": "node scripts/test-contracts.mjs && node scripts/run-gradle.mjs :services:tenant-service:test --tests com.genealogy.platform.services.tenant.ContractInvariantsTest",
    "test:e2e": "pnpm run -r --parallel test:e2e",
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf node_modules",
    "check:workspaces": "node scripts/check-monorepo-boundaries.mjs",
    "check:lockfile": "node scripts/check-monorepo-lockfile.mjs",
    "check:gradle:lock": "node scripts/check-gradle-lockfile.mjs",
    "check:java": "node scripts/run-gradle.mjs checkstyleMain checkstyleTest test",
    "check:java:format": "node scripts/run-gradle.mjs spotlessApply 2>/dev/null || echo 'Spotless apply is staged for E1.6 (see gradle/conventions/java-conventions.gradle.kts)'",
    "check:java:test": "node scripts/run-gradle.mjs test",
    "check:boundary": "node scripts/check-monorepo-boundaries.mjs",
    "check:ownership": "node scripts/check-ownership-coverage.mjs",
    "check:generated": "node scripts/check-generated-code.mjs",
    "check:platform": "pnpm lint:helm && pnpm lint:kong && pnpm lint:kafka && pnpm lint:temporal && pnpm lint:istio && pnpm lint:vault && pnpm lint:s3 && pnpm check:s3:compat && pnpm lint:flagsmith && pnpm lint:argo && pnpm lint:grafana && pnpm lint:keycloak && pnpm lint:openfga && pnpm lint:abac && pnpm lint:audit && pnpm lint:trustedContext && pnpm lint:tree && pnpm lint:person && pnpm lint:dateplace && pnpm lint:relationship && pnpm lint:eventClaim && pnpm lint:personMerge && pnpm lint:outboxRelay && pnpm lint:treeRendererBench && pnpm lint:treeProjection && pnpm lint:profileEditor && pnpm lint:research && pnpm lint:collaboration && pnpm lint:collaboration:mixed && pnpm lint:a11yI18n && node scripts/check-platform-baseline.mjs",
    "check:platform:baseline": "node scripts/check-platform-baseline.mjs",
    "check:kong": "pnpm lint:kong && node scripts/check-platform-baseline.mjs",
    "check:kafka": "pnpm lint:kafka && node scripts/check-platform-baseline.mjs",
    "check:temporal": "pnpm lint:temporal && node scripts/check-platform-baseline.mjs",
    "check:istio": "pnpm lint:istio && node scripts/check-platform-baseline.mjs",
    "check:vault": "pnpm lint:vault && node scripts/check-platform-baseline.mjs",
    "check:s3": "pnpm lint:s3 && pnpm check:s3:compat && node scripts/check-platform-baseline.mjs",
    "check:flagsmith": "pnpm lint:flagsmith && node scripts/check-platform-baseline.mjs",
    "check:argo": "pnpm lint:argo && node scripts/check-platform-baseline.mjs",
    "check:grafana": "pnpm lint:grafana && node scripts/check-platform-baseline.mjs",
    "check:keycloak": "pnpm lint:keycloak && node scripts/check-platform-baseline.mjs",
    "check:openfga": "pnpm lint:openfga && node --test contracts/openfga/compatibility.test.mjs && node scripts/check-platform-baseline.mjs",
    "check:abac": "pnpm lint:abac && node --test scripts/__tests__/lint-abac-config.test.mjs",
    "check:abac-trustedContext": "pnpm check:abac && pnpm check:trustedContext",
    "check:contracts": "pnpm lint:openapi && pnpm lint:protobuf && pnpm lint:events",
    "check:docs": "pnpm lint:markdown",
    "security": "node scripts/security-ci.mjs all",
    "security:secrets": "node scripts/security-ci.mjs secrets",
    "security:sast": "node scripts/security-ci.mjs sast",
    "security:vuln": "node scripts/security-ci.mjs vuln",
    "security:iac": "node scripts/security-ci.mjs iac",
    "security:sbom": "node scripts/security-ci.mjs sbom",
    "security:license": "node scripts/security-ci.mjs license",
    "security:baseline": "docker run --rm -v \"${PWD}:/src:ro\" -w /src ghcr.io/gitleaks/gitleaks:v8.21.2 detect --no-banner --config /src/security/gitleaks.toml --report-path /src/security/.gitleaks-baseline.json --report-format json --source /src",
    "check:all": "pnpm check:boundary && pnpm check:lockfile && pnpm check:gradle:lock && pnpm check:ownership && pnpm check:generated && pnpm lint:eslint && pnpm lint:yaml && pnpm lint:openapi && pnpm lint:protobuf && pnpm lint:events && pnpm lint:helm && pnpm lint:kong && pnpm lint:kafka && pnpm lint:markdown && pnpm typecheck && pnpm test:unit && pnpm check:java:format && pnpm check:java && pnpm check:java:test && pnpm check:platform:baseline",
    "release": "turbo run build --filter=...{git origin/main...HEAD}",
    "ci:quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm check:java && pnpm check:boundary",
    "ci:full": "pnpm ci:quality && pnpm test:integration && pnpm test:contract && pnpm test:e2e && pnpm lint:ownership && pnpm lint:generated && pnpm lint:helm && pnpm lint:kong && pnpm lint:kafka && pnpm lint:temporal && pnpm lint:istio && pnpm lint:vault && pnpm lint:s3 && pnpm check:s3:compat && pnpm lint:flagsmith && pnpm lint:argo && pnpm lint:grafana && pnpm lint:keycloak && pnpm lint:openfga && pnpm lint:abac && pnpm lint:audit && pnpm lint:trustedContext && pnpm lint:tree && pnpm lint:person && pnpm lint:dateplace && pnpm lint:relationship && pnpm lint:eventClaim && pnpm lint:personMerge && pnpm lint:outboxRelay && pnpm lint:treeRendererBench && pnpm lint:treeProjection && pnpm lint:profileEditor && pnpm lint:research && pnpm lint:collaboration && pnpm lint:collaboration:mixed && pnpm lint:a11yI18n && pnpm check:platform && pnpm check:platform:baseline && pnpm smoke:kong && pnpm smoke:apicurio && pnpm smoke:temporal && pnpm smoke:istio && pnpm smoke:vault && pnpm smoke:s3 && pnpm smoke:flagsmith && pnpm smoke:argo && pnpm smoke:grafana && pnpm smoke:keycloak && pnpm smoke:openfga && pnpm smoke:a11y"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@stoplight/spectral-cli": "6.14.2",
    "@types/node": "22.7.4",
    "eslint": "9.13.0",
    "eslint-config-prettier": "9.1.0",
    "markdownlint-cli2": "0.14.0",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "turbo": "2.1.3",
    "typescript": "5.6.2",
    "typescript-eslint": "8.12.2",
    "yaml": "2.6.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "allowedDeprecatedVersions": [],
    "onlyBuiltDependencies": []
  }
}
