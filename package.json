{
  "name": "genealogy-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Genealogy Platform monorepo — SaaS + on-premise, privacy-first, contract-first.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "format": "pnpm run -r --parallel format && pnpm format:root",
    "format:root": "prettier --write --log-level=warn --ignore-unknown --no-error-on-unmatched-pattern \".github/**/*.{md,yaml,yml,json}\" \"*.{md,json,yaml,yml}\" \"docs/**/*.md\" \"config/**/*.yaml\" \".kiro/**/*.md\"",
    "format:check": "pnpm run -r --parallel format:check && pnpm exec prettier --check --log-level=warn --ignore-unknown --no-error-on-unmatched-pattern \".github/**/*.{md,yaml,yml,json}\" \"*.{md,json,yaml,yml}\" \"docs/**/*.md\" \"config/**/*.yaml\" \".kiro/**/*.md\"",
    "lint": "pnpm run -r --parallel lint && pnpm lint:root",
    "lint:root": "pnpm lint:eslint && pnpm lint:yaml && pnpm lint:openapi && pnpm lint:markdown && pnpm lint:ownership",
    "lint:eslint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern \"{packages,tools,scripts}/**/*.{ts,tsx,js,mjs,cjs,mts,cts}\" \"*.{js,mjs,cjs,mts,cts}\"",
    "lint:yaml": "node scripts/lint-yaml.mjs",
    "lint:openapi": "node scripts/lint-openapi.mjs",
    "lint:events": "node scripts/lint-events.mjs",
    "lint:markdown": "markdownlint-cli2 --config .markdownlint-cli2.jsonc \"**/*.md\" \"#node_modules\" \"#**/node_modules\" \"#**/build\" \"#**/dist\" \"#**/.next\" \"#**/target\" \"#**/coverage\" \"#**/.gradle\"",
    "lint:helm": "node scripts/lint-helm.mjs",
    "lint:protobuf": "node scripts/lint-protobuf.mjs",
    "lint:kong": "node scripts/lint-kong-config.mjs",
    "smoke:kong": "node scripts/smoke-kong.mjs",
    "lint:kafka": "node scripts/lint-kafka-config.mjs",
    "smoke:apicurio": "node scripts/smoke-apicurio.mjs",
    "lint:ownership": "node scripts/check-ownership-coverage.mjs",
    "lint:generated": "node scripts/check-generated-code.mjs",
    "typecheck": "pnpm run -r --parallel typecheck",
    "test": "pnpm run -r --parallel test",
    "test:unit": "pnpm run -r --parallel test:unit && pnpm test:scripts",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:integration": "pnpm run -r --parallel test:integration",
    "test:contract": "node scripts/test-contracts.mjs && node scripts/run-gradle.mjs :services:tenant-service:test --tests com.genealogy.platform.services.tenant.ContractInvariantsTest",
    "test:e2e": "pnpm run -r --parallel test:e2e",
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf node_modules",
    "check:workspaces": "node scripts/check-monorepo-boundaries.mjs",
    "check:lockfile": "node scripts/check-monorepo-lockfile.mjs",
    "check:gradle:lock": "node scripts/check-gradle-lockfile.mjs",
    "check:java": "node scripts/run-gradle.mjs checkstyleMain checkstyleTest test",
    "check:java:format": "node scripts/run-gradle.mjs spotlessApply 2>/dev/null || echo 'Spotless apply is staged for E1.6 (see gradle/conventions/java-conventions.gradle.kts)'",
    "check:java:test": "node scripts/run-gradle.mjs test",
    "check:boundary": "node scripts/check-monorepo-boundaries.mjs",
    "check:ownership": "node scripts/check-ownership-coverage.mjs",
    "check:generated": "node scripts/check-generated-code.mjs",
    "check:platform": "pnpm lint:helm && pnpm lint:kong && pnpm lint:kafka && node scripts/check-platform-baseline.mjs",
    "check:platform:baseline": "node scripts/check-platform-baseline.mjs",
    "check:kong": "pnpm lint:kong && node scripts/check-platform-baseline.mjs",
    "check:kafka": "pnpm lint:kafka && node scripts/check-platform-baseline.mjs",
    "check:contracts": "pnpm lint:openapi && pnpm lint:protobuf && pnpm lint:events",
    "check:docs": "pnpm lint:markdown",
    "security": "node scripts/security-ci.mjs all",
    "security:secrets": "node scripts/security-ci.mjs secrets",
    "security:sast": "node scripts/security-ci.mjs sast",
    "security:vuln": "node scripts/security-ci.mjs vuln",
    "security:iac": "node scripts/security-ci.mjs iac",
    "security:sbom": "node scripts/security-ci.mjs sbom",
    "security:license": "node scripts/security-ci.mjs license",
    "security:baseline": "docker run --rm -v \"${PWD}:/src:ro\" -w /src ghcr.io/gitleaks/gitleaks:v8.21.2 detect --no-banner --config /src/security/gitleaks.toml --report-path /src/security/.gitleaks-baseline.json --report-format json --source /src",
    "check:all": "pnpm check:boundary && pnpm check:lockfile && pnpm check:gradle:lock && pnpm check:ownership && pnpm check:generated && pnpm lint:eslint && pnpm lint:yaml && pnpm lint:openapi && pnpm lint:protobuf && pnpm lint:events && pnpm lint:helm && pnpm lint:kong && pnpm lint:kafka && pnpm lint:markdown && pnpm typecheck && pnpm test:unit && pnpm check:java:format && pnpm check:java && pnpm check:java:test && pnpm check:platform:baseline",
    "release": "turbo run build --filter=...{git origin/main...HEAD}",
    "ci:quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm check:java && pnpm check:boundary",
    "ci:full": "pnpm ci:quality && pnpm test:integration && pnpm test:contract && pnpm test:e2e && pnpm lint:ownership && pnpm lint:generated && pnpm lint:helm && pnpm lint:kong && pnpm lint:kafka && pnpm check:platform && pnpm check:platform:baseline && pnpm smoke:kong && pnpm smoke:apicurio"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@stoplight/spectral-cli": "6.14.2",
    "@types/node": "22.7.4",
    "eslint": "9.13.0",
    "eslint-config-prettier": "9.1.0",
    "markdownlint-cli2": "0.14.0",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "turbo": "2.1.3",
    "typescript": "5.6.2",
    "typescript-eslint": "8.12.2",
    "yaml": "2.6.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "allowedDeprecatedVersions": [],
    "onlyBuiltDependencies": []
  }
}
