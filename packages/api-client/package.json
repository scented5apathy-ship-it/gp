{
  "name": "@genealogy/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed REST client generated from contracts/openapi/ — see apps/web/scripts/codegen-openapi-client.mjs.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./problem": "./src/runtime/problem.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,mjs,cjs,mts,cts}\"",
    "lint:eslint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,mjs,cjs,mts,cts}\"",
    "lint:yaml": "node ../../scripts/lint-yaml.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/test-ts.mjs \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:unit": "node ../../scripts/test-ts.mjs \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:integration": "echo 'no integration tests for api-client package yet'",
    "test:contract": "echo 'no contract tests for api-client package yet'",
    "test:e2e": "echo 'no e2e tests for api-client package yet'",
    "codegen:client": "echo 'generated types live in apps/web/src/lib/api/generated/ (see apps/web/scripts/codegen-openapi-client.mjs)'",
    "build": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write --log-level=warn --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}\" \"package.json\"",
    "format:check": "prettier --check --log-level=warn --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json}\" \"package.json\"",
    "clean": "rimraf node_modules dist .turbo coverage"
  },
  "devDependencies": {
    "typescript": "5.6.2",
    "eslint": "9.13.0",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "openapi-typescript": "7.4.2",
    "js-yaml": "4.1.0"
  },
  "peerDependencies": {}
}
